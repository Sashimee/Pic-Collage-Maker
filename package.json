{
  "name": "pic-collage-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "size": "vite build --report",
    "build": "tsc -b && vite build",
    "build:lh": "vite build --base=/ --outDir dist-lh",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:bundle": "node scripts/check-bundle.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:og": "node scripts/generate-og.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:offline": "playwright test -c e2e/offline.config.ts",
    "analyze": "vite build --mode analyze"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.42.2",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "konva": "^10.3.0",
    "lucide-react": "^1.24.0",
    "pdf-lib": "^1.17.1",
    "piexif": "^0.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-konva": "^19.2.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.1.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
